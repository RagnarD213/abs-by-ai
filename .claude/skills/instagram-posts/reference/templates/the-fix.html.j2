{#- THE FIX: mistake, then fix, from real footage of Dan. Approved 2026-10-21 (C1 jump rope). 5 slides:
    cover (the mistake, big) / the mistake / the fix / 3 cues / save + send + follow. -#}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block slides %}
{%- set T = 5 -%}
{%- set c = post.cover -%}
<!-- 1 COVER -->
<div class="slide" style="background:var(--ink)">
  {{ m.head(post.tag, 1, T) }}
  <div data-fit-col style="position:absolute;left:36px;right:36px;top:66px;height:124px">
    <h1 class="hd" data-fit="{{ c.size or 66 }},40" style="font-size:{{ c.size or 66 }}px;color:var(--bone)">{{ c.headline|mk }}</h1>
  </div>
  {%- set legacy = [{'ring': c.ring, 'pill': c.callout, 'at': c.callout_at}] if c.ring or c.callout else [] -%}
  {%- set extra -%}
    {{ m.marks(legacy + (c.marks or [])) }}
    <div class="handle" style="position:absolute;left:20px;bottom:20px;color:var(--bone);background:rgba(14,16,19,.74);padding:6px 10px;border-radius:4px">@danrosefit</div>
    <div class="tx" style="position:absolute;right:20px;bottom:18px;display:flex;align-items:center;gap:8px;background:var(--yellow);color:var(--ink);font-weight:800;font-size:17px;padding:8px 14px;border-radius:4px">{{ c.swipe or 'Swipe for the fix' }} {{ m.ICON.arrow|safe }}</div>
  {%- endset -%}
  {{ m.pic(c.image, 'left:0;right:0;top:196px;height:479px', extra) }}
</div>

{%- for key, n, tone in [('mistake', 2, 'bad'), ('fix', 3, 'good')] %}
{%- set s = post[key] %}
<!-- {{ n }} {{ key|upper }} -->
<div class="slide" style="background:var(--ink)">
  {%- set extra -%}
    {{ m.overtag(post.tag) }}
    <div style="position:absolute;right:22px;top:18px;width:58px;height:58px;border-radius:50%;background:{{ 'var(--red)' if tone == 'bad' else 'var(--yellow)' }};color:{{ '#fff' if tone == 'bad' else 'var(--ink)' }};display:flex;align-items:center;justify-content:center;z-index:3">{{ (m.ICON.x if tone == 'bad' else m.ICON.check)|safe }}</div>
    {{ m.label(s.image, 'left:18px;bottom:14px') }}
    {{ m.marks(s.marks, 'red' if tone == 'bad' else 'yellow') }}
  {%- endset -%}
  {{ m.pic(s.image, 'left:0;right:0;top:0;height:330px', extra) }}
  <div data-fit-col style="position:absolute;left:36px;right:36px;top:354px;height:268px;display:flex;flex-direction:column;gap:12px;overflow:hidden">
    <div><span class="pill" style="background:{{ 'var(--red)' if tone == 'bad' else 'var(--yellow)' }};color:{{ '#fff' if tone == 'bad' else 'var(--ink)' }}">{{ s.pill or ('The mistake' if tone == 'bad' else 'The fix') }}</span></div>
    <h2 class="hd" data-fit="{{ s.size or 46 }},36" style="font-size:{{ s.size or 46 }}px;color:var(--bone)">{{ s.headline|mk }}</h2>
    <p class="tx" data-fit="19,18" style="margin:0;font-size:19px;line-height:1.42;font-weight:600;color:var(--body-d)">{{ s.body|mk }}</p>
  </div>
  {{ m.foot(n, T) }}
</div>
{%- endfor %}

{%- set s = post.cues %}
<!-- 4 CUES -->
<div class="slide" style="background:var(--bone)">
  {{ m.pic(s.image, 'left:0;top:0;width:228px;height:675px', m.label(s.image, 'left:18px;bottom:20px;width:178px;line-height:1.25')) }}
  <div data-fit-col style="position:absolute;left:256px;right:28px;top:28px;height:600px;display:flex;flex-direction:column;gap:16px;overflow:hidden">
    <div class="tag" style="color:var(--ink)"><span class="sq"></span>{{ post.tag }}</div>
    <div>
      <h2 class="hd" data-fit="64,40" style="font-size:64px;color:var(--ink)">{{ s.title or '3 cues' }}</h2>
      {%- if s.subtitle %}<div class="tx" style="font-size:17px;font-weight:700;color:var(--mute-l);margin-top:4px">{{ s.subtitle|mk }}</div>{% endif %}
    </div>
    {%- for it in s['items'] %}
    <div style="display:flex;gap:14px;align-items:flex-start">
      <div class="hd" style="font-size:36px;color:var(--red);width:40px;flex:none">{{ '%02d'|format(loop.index) }}</div>
      <p class="tx" data-fit="19,18" style="margin:0;font-size:19px;line-height:1.36;font-weight:700;color:var(--ink)">{{ it|mk }}</p>
    </div>
    {%- endfor %}
  </div>
  {{ m.foot(4, T, dark=False, left=256, right=28) }}
</div>

{%- set s = post.cta %}
<!-- 5 CTA: save + send, Dan's cutout large on the right -->
<div class="slide" style="background:var(--yellow);padding:30px 36px">
  <div style="display:flex;justify-content:space-between;align-items:center;position:relative;z-index:2">
    <div class="tag" style="color:var(--ink)"><span class="sq" style="background:var(--ink)"></span>{{ post.tag }}</div>
    <div class="handle" style="color:var(--ink)">5 / 5</div>
  </div>
  {{ m.dan_cutout(s.cutout or post.follow_cutout, height=s.cutout_h or 560) }}
  <div data-fit-col style="position:absolute;left:36px;width:262px;top:86px;height:{{ 470 }}px;display:flex;flex-direction:column;gap:22px;overflow:hidden;z-index:2">
  {%- for b in s.blocks %}
    {%- if not loop.first %}<div style="height:3px;background:var(--ink);flex:none"></div>{% endif %}
    <div style="display:flex;flex-direction:column;gap:6px">
      <div style="display:flex;align-items:center;gap:10px;color:var(--ink)">{{ m.ICON[b.icon]|replace('width="54" height="54"', 'width="44" height="44" style="flex:none"')|safe }}<h2 class="hd" data-fit="{{ b.size or 64 }},40" style="font-size:{{ b.size or 64 }}px;color:var(--ink);white-space:nowrap">{{ b.title }}</h2></div>
      <p class="tx" data-fit="23,18" style="margin:0;font-size:23px;font-weight:700;line-height:1.3;color:var(--ink)">{{ b.text|mk }}</p>
    </div>
  {%- endfor %}
  </div>
  {{ m.follow_text(s.follow or 'One fix a week, filmed on me.') }}
</div>
{% endblock %}
