{#- STEAL MY WORKOUT: a routine Dan really does, one move per slide, recap card to screenshot. Approved 2026-10-21
    (C3 home abs). Slides: cover / one per move (2 to 4 moves) / recap + follow. -#}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block slides %}
{%- set T = post.moves|length + 2 -%}
{%- set c = post.cover -%}
<!-- 1 COVER -->
<div class="slide" style="background:var(--ink)">
  {{ m.head(post.tag or 'Steal my workout', 1, T) }}
  <div data-fit-col style="position:absolute;left:36px;right:36px;top:66px;height:212px;overflow:hidden">
    <h1 class="hd" data-fit="{{ c.size or 70 }},40" style="font-size:{{ c.size or 70 }}px;color:var(--bone)">{{ c.headline|mk }}</h1>
  </div>
  <div aria-hidden="true" style="position:absolute;left:236px;top:272px;width:300px;height:300px;box-sizing:border-box;border:10px solid var(--yellow);border-radius:50%"></div>
  <div aria-hidden="true" style="position:absolute;left:380px;top:258px;width:12px;height:34px;background:var(--yellow)"></div>
  {%- if c.cutout.placeholder %}
  {{ m.pic(c.cutout, 'right:40px;bottom:0;width:250px;height:400px') }}
  {%- else %}
  <img src="{{ c.cutout.src|uri }}" alt="{{ c.cutout.alt or 'Dan Rose' }}" style="position:absolute;right:{{ c.cutout.right or 64 }}px;bottom:0;height:{{ c.cutout.height or 430 }}px;width:auto">
  {%- endif %}
  <div style="position:absolute;left:36px;top:318px;width:200px;display:flex;flex-direction:column;gap:12px">
    {%- for mv in post.moves %}
    <div style="display:flex;gap:10px;align-items:baseline"><span class="hd" style="font-size:24px;color:var(--yellow)">{{ '%02d'|format(loop.index) }}</span><span class="tx" style="font-size:18px;font-weight:700;color:var(--bone)">{{ mv.name }}</span></div>
    {%- endfor %}
    <div class="tx" style="margin-top:16px;display:flex;align-items:center;gap:8px;font-size:18px;font-weight:800;color:var(--yellow)">{{ c.swipe or 'Swipe to steal it' }} {{ m.ICON.arrow|safe }}</div>
  </div>
  <div class="handle" style="position:absolute;left:36px;bottom:20px;color:var(--mute-d)">@danrosefit</div>
</div>

{%- for mv in post.moves %}
<!-- {{ loop.index + 1 }} {{ mv.name|upper }} -->
<div class="slide" style="background:var(--ink)">
  {%- set extra -%}{{ m.overtag(post.tag or 'Steal my workout') }}{{ m.label(mv.image, 'left:18px;bottom:14px') }}{%- endset -%}
  {{ m.pic(mv.image, 'left:0;right:0;top:0;height:330px', extra) }}
  <div style="position:absolute;left:36px;right:36px;top:350px;display:flex;gap:20px;align-items:flex-start">
    <div class="hd" style="font-size:110px;color:var(--yellow);line-height:.85">{{ '%02d'|format(loop.index) }}</div>
    <div data-fit-col style="display:flex;flex-direction:column;gap:12px;padding-top:4px;height:120px;overflow:hidden;flex:1">
      <h2 class="hd" data-fit="{{ mv.size or 42 }},35" style="font-size:{{ mv.size or 42 }}px;color:var(--bone)">{{ mv.name }}</h2>
      <div class="chip">{{ (m.ICON.clock if (mv.dose_icon or 'clock') == 'clock' else '')|safe }}<span class="hd" style="font-size:28px;white-space:nowrap">{{ mv.dose }}</span></div>
    </div>
  </div>
  <div data-fit-col style="position:absolute;left:36px;right:36px;top:486px;height:144px;display:flex;flex-direction:column;gap:8px;overflow:hidden">
    {%- for cue in mv.cues %}
    <div class="cue" data-fit="19,18"><span class="dot"></span><span>{{ cue|mk }}</span></div>
    {%- endfor %}
  </div>
  {{ m.foot(loop.index + 1, T) }}
</div>
{%- endfor %}

{%- set r = post.recap %}
<!-- {{ T }} RECAP -->
<div class="slide" style="background:var(--yellow);padding:30px 36px">
  <div style="display:flex;justify-content:space-between;align-items:center">
    <div class="tag" style="color:var(--ink)"><span class="sq" style="background:var(--ink)"></span>{{ post.tag or 'Steal my workout' }}</div>
    <div class="handle" style="color:var(--ink)">{{ T }} / {{ T }}</div>
  </div>
  <h2 class="hd" style="font-size:{{ r.size or 60 }}px;color:var(--ink);margin-top:{{ 24 if post.moves|length > 3 else 30 }}px">{{ r.title or 'Screenshot this.' }}</h2>
  <div style="margin-top:16px;background:var(--ink);border-radius:8px;padding:{{ 12 if post.moves|length > 3 else 16 }}px 16px;display:flex;flex-direction:column;gap:{{ 9 if post.moves|length > 3 else 12 }}px">
    {%- for mv in post.moves %}
    <div style="display:flex;align-items:center;gap:14px">
      {%- if mv.image.placeholder %}
      <div style="width:84px;height:{{ 52 if post.moves|length > 3 else 64 }}px;border-radius:4px;flex:none;background:repeating-linear-gradient(135deg,#2A2E35 0 8px,#23272D 8px 16px)"></div>
      {%- else %}
      <img src="{{ mv.image.src|uri }}" alt="" data-nolabel="1" style="width:84px;height:{{ 52 if post.moves|length > 3 else 64 }}px;object-fit:cover;object-position:{{ mv.thumb_pos or mv.image.pos or '50% 50%' }};border-radius:4px;flex:none">
      {%- endif %}
      <span class="tx" style="flex:1;font-size:20px;font-weight:800;color:var(--bone)">{{ mv.name }}</span>
      <span class="hd" style="font-size:{{ mv.recap_size or 28 }}px;color:var(--yellow);white-space:nowrap">{{ mv.dose }}</span>
    </div>
    {%- endfor %}
    {%- if r.note %}<div class="tx" style="font-size:17px;font-weight:700;color:var(--yellow);border-top:1px solid #3A3F46;padding-top:8px">{{ r.note|mk }}</div>{% endif %}
  </div>
  <p class="tx" style="margin:16px 0 0;font-size:{{ r.text_size or 21 }}px;line-height:1.36;font-weight:700;color:var(--ink)">{{ r.text|mk }}</p>
  <div class="tx" data-label style="position:absolute;right:36px;bottom:112px;font-size:16px;font-weight:600;color:var(--ink);opacity:.8">{{ r.label or 'Real photos of me, not AI-generated' }}</div>
  {{ m.follow(r.follow or 'Workouts I actually do.', post.avatar) }}
</div>
{% endblock %}
