{#- Macros shared by every format template: import with `{% import "_macros.html.j2" as m with context %}`. -#}
{%- macro label(img, style) -%}
{%- if img and not img.placeholder and img.label in ('real','ai','screenshot') -%}
<div class="lbl" style="{{ style }}">{{ {'real':'Real photo of me, not AI-generated','ai':'AI-generated image','screenshot':'Real screenshot'}[img.label] }}</div>
{%- endif -%}
{%- endmacro -%}

{#- An image filling its positioned box: cover crop, focal point `pos`, optional `zoom` around that point.
    A placeholder shows the exact shot still to be filmed. -#}
{%- macro pic(img, box, extra='') -%}
<div class="frame" style="{{ box }}">
{%- if img.placeholder %}
  <div class="ph"><b>Film at next shoot</b><span>{{ img.placeholder }}</span></div>
{%- else %}
  <img src="{{ img.src|uri }}" alt="{{ img.alt or '' }}" style="object-position:{{ img.pos or '50% 50%' }};transform:scale({{ img.zoom or 1 }});transform-origin:{{ img.pos or '50% 50%' }}">
{%- endif %}
{{ extra|safe }}
</div>
{%- endmacro -%}

{%- macro foot(n, total, dark=True, left=36, right=36) -%}
<div style="position:absolute;left:{{ left }}px;right:{{ right }}px;bottom:20px;display:flex;justify-content:space-between">
  <span class="handle" style="color:{{ 'var(--mute-d)' if dark else 'var(--mute-l)' }}">@danrosefit</span><span class="handle" style="color:{{ 'var(--mute-d)' if dark else 'var(--mute-l)' }}">{{ n }} / {{ total }}</span>
</div>
{%- endmacro -%}

{%- macro head(tagtext, n, total, dark=True) -%}
<div style="position:absolute;left:36px;right:36px;top:28px;display:flex;justify-content:space-between;align-items:center">
  <div class="tag" style="color:{{ 'var(--bone)' if dark else 'var(--ink)' }}"><span class="sq"></span>{{ tagtext }}</div>
  <div class="handle" style="color:{{ 'var(--mute-d)' if dark else 'var(--mute-l)' }}">{{ n }} / {{ total }}</div>
</div>
{%- endmacro -%}

{%- macro overtag(tagtext) -%}
<div class="tag" style="position:absolute;left:20px;top:20px;color:var(--bone);background:rgba(14,16,19,.74);padding:6px 10px;border-radius:4px;z-index:3"><span class="sq"></span>{{ tagtext }}</div>
{%- endmacro -%}

