{#- Last-slide follow row with Dan's avatar -#}
{%- macro follow(line, avatar, bottom=30) -%}
<div style="position:absolute;left:36px;right:36px;bottom:{{ bottom }}px;display:flex;align-items:center;gap:16px">
  <img src="{{ avatar|uri }}" alt="Dan Rose" style="width:64px;height:64px;border-radius:50%;border:3px solid var(--ink);object-fit:cover;flex:none">
  <div class="tx" style="color:var(--ink)">
    <div style="font-weight:800;font-size:22px">Follow @danrosefit</div>
    <div style="font-weight:600;font-size:17px">{{ line }}</div>
  </div>
</div>
{%- endmacro -%}

{#- Circles, callout pills and arrows drawn on a photo. Coordinates are css px inside the photo's box.
    mark = {"ring": [x, y, w, h]?, "pill": "text"?, "at": [x, y]?, "tone": "red"|"yellow"?, "arrow": [[x1, y1], [x2, y2]]?} -#}
{%- macro marks(list, tone='red') -%}
{%- for k in list or [] %}
{%- set t = k.tone or tone %}
{%- set col = 'var(--red)' if t == 'red' else 'var(--yellow)' %}
{%- if k.ring %}<div style="position:absolute;left:{{ k.ring[0] }}px;top:{{ k.ring[1] }}px;width:{{ k.ring[2] }}px;height:{{ k.ring[3] }}px;border:4px solid {{ col }};border-radius:50%;z-index:2;box-shadow:0 0 0 2px rgba(14,16,19,.25)"></div>{% endif %}
{%- if k.arrow %}<svg style="position:absolute;left:0;top:0;width:100%;height:100%;overflow:visible;z-index:2" aria-hidden="true"><defs><marker id="ah{{ loop.index }}{{ t }}" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="{{ '#D33A2C' if t == 'red' else '#FFD23F' }}"/></marker></defs><line x1="{{ k.arrow[0][0] }}" y1="{{ k.arrow[0][1] }}" x2="{{ k.arrow[1][0] }}" y2="{{ k.arrow[1][1] }}" stroke="{{ '#D33A2C' if t == 'red' else '#FFD23F' }}" stroke-width="4" stroke-linecap="round" marker-end="url(#ah{{ loop.index }}{{ t }})"/></svg>{% endif %}
{%- if k.pill %}<div class="pill" style="position:absolute;left:{{ k.at[0] }}px;top:{{ k.at[1] }}px;background:{{ col }};color:{{ '#fff' if t == 'red' else 'var(--ink)' }};z-index:3;box-shadow:0 2px 8px rgba(14,16,19,.35)">{{ k.pill }}</div>{% endif %}
{%- endfor %}
{%- endmacro -%}

{#- Dan Rose's default last-slide cutout (Dan, 2026-10-22: never the face avatar, always a larger shirtless studio cutout). -#}
{%- set DEFAULT_CUTOUT = 'Short-form video content/instagram-danrosefit/assets/_cutouts/studio-blue-111.webp' -%}

{#- Large shirtless cutout standing in the bottom-right corner, labelled over the legs. -#}
{%- macro dan_cutout(src, height=560, maxw=250, right=0, label='Real photo of me, not AI-generated') -%}
<img src="{{ (src or DEFAULT_CUTOUT)|uri }}" alt="Dan Rose, shirtless" data-nolabel="1" style="position:absolute;right:{{ right }}px;bottom:0;height:{{ height }}px;width:auto;max-width:{{ maxw }}px;object-fit:contain;object-position:bottom right;z-index:1">
<div class="lbl" style="right:20px;bottom:16px;width:150px;line-height:1.25;text-align:center">{{ label }}</div>
{%- endmacro -%}

{#- Follow line without the face avatar (sits bottom-left beside the cutout). -#}
{%- macro follow_text(line, bottom=30, width=270) -%}
<div class="tx" style="position:absolute;left:36px;width:{{ width }}px;bottom:{{ bottom }}px;color:var(--ink);z-index:2">
  <div style="font-weight:800;font-size:22px">Follow @danrosefit</div>
  <div style="font-weight:600;font-size:17px">{{ line }}</div>
</div>
{%- endmacro -%}
