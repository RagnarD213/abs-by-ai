# Environment variables
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Vercel
.vercel

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Private, restorable snapshot of the retired Decision Counsel feature.
# MUST stay ignored: express.static('.') serves the whole repo over HTTP, so
# committing this would publish it. Local-only backup — see _counsel_archive/README.md
_counsel_archive/

# Bake-off test images (55MB+ of generated candidates and source photos).
# The harness code, prompts, results.json and the blind key ARE committed —
# only the image bytes stay local so the deploy repo doesn't carry them.
bakeoff/round1/images/
bakeoff/round1/photos/
bakeoff/**/.env

# Logs
logs/
*.log
npm-debug.log*

# Android build artifacts & signing secrets (back up the keystore separately!)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore/
android/keystore.properties
bakeoff/round1/scaled/

# Live API/session tokens written by helper scripts — never commit
.demotoken
**/.demotoken
native-smoke-out/

# AI ad factory work files (video/audio/images — public repo, keep out of git)
ad-factory/

# macOS/iCloud/Drive sync-conflict duplicate copies ("file 2.md", "file 7.json", etc.)
# Verified against `git ls-files` before adding — no tracked file matches this pattern.
* [0-9].md
* [0-9].json
* [0-9].js
* [0-9].sh
* [0-9].txt

# Local-only working media, not part of the deployed app.
# Covers Media/B roll, Media/video_edit, Media/abs by ai images, Media/example
# pictures, Media/dan future visualizations, and Media/photos (real personal
# photos). One rule instead of per-folder rules: the repo is public, so the
# default for this tree is "never commit". Production art lives in public/img/
# and assets/judge-exemplars/, which are outside Media/ and stay tracked.
Media/

# Company formation and legal paperwork — repo is public, never commit.
Business/

YouTube Content/
Short-form video content/
